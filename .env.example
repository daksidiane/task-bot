# ===== Обязательные =====
# Токен бота от @BotFather
TG_BOT_TOKEN=123456789:AA-ЗАМЕНИ-МЕНЯ

# Telegram ID администраторов через запятую (узнать можно у @userinfobot или командой /myid)
ADMIN_IDS=123456789

# Telegram ID заказчика(ов) через запятую. Если пусто — заказчик = администраторы
CUSTOMER_IDS=

# ===== Локальные AI =====
# Адрес локального Ollama (можно задать HOST:PORT как http://<vps-ip>:11434)
OLLAMA_URL=http://localhost:11434
# Модель по ТЗ — Llama 3.1 8B
OLLAMA_MODEL=llama3.1:8b
# Транскрипция голосовых локальным Whisper (нужен пакет openai-whisper)
USE_WHISPER=true
# base — быстро, small — баланс (рекоменд.), medium — лучше качество, но тяжелее
WHISPER_MODEL=base

# ===== Хранилище =====
# local — файловый JSON (для разработки); sheets — Google Sheets (бэкенд по ТЗ)
STORAGE_BACKEND=local
STORAGE_PATH=data/bot_data.json
# Для STORAGE_BACKEND=sheets:
GOOGLE_SERVICE_ACCOUNT=secrets/service_account.json
GOOGLE_SHEET_ID=

# ===== Логика контроля дедлайнов =====
# Напоминание исполнителю за N часов до дедлайна
REMINDER_HOURS_BEFORE=6
# Эскалация заказчику при просрочке больше N минут
ESCALATE_AFTER_MINUTES=5

# Часовой пояс
TZ=Europe/Moscow